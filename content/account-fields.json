{
  "overview": {
    "title": "My Account",
    "description": "Manage your contact details, pets, service addresses, and saved payment methods for faster booking."
  },
  "sections": [
    {
      "id": "profile",
      "path": "/account/profile",
      "title": "Personal Information",
      "description": "Your name and how we reach you about appointments.",
      "fields": [
        {
          "id": "firstName",
          "label": "First Name",
          "type": "text",
          "required": true,
          "placeholder": "Jane"
        },
        {
          "id": "lastName",
          "label": "Last Name",
          "type": "text",
          "required": true,
          "placeholder": "Miller"
        },
        {
          "id": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "placeholder": "you@example.com"
        },
        {
          "id": "phone",
          "label": "Mobile Phone",
          "type": "tel",
          "required": true,
          "placeholder": "(555) 123-4567"
        },
        {
          "id": "preferredContact",
          "label": "Preferred Contact Method",
          "type": "select",
          "required": false,
          "options": ["Email", "Text Message"]
        },
        {
          "id": "emergencyContactHeading",
          "label": "Emergency Contact",
          "type": "section-heading",
          "required": false
        },
        {
          "id": "emergencyContactName",
          "label": "Emergency Contact Name",
          "type": "text",
          "required": false,
          "placeholder": "John Miller"
        },
        {
          "id": "emergencyContactPhone",
          "label": "Emergency Contact Phone",
          "type": "tel",
          "required": false,
          "placeholder": "(555) 987-6543"
        },
        {
          "id": "emergencyContactRelationship",
          "label": "Relationship",
          "type": "select",
          "required": false,
          "options": ["Spouse", "Partner", "Family", "Friend", "Neighbor", "Other"]
        }
      ]
    },
    {
      "id": "addresses",
      "path": "/account/addresses",
      "title": "Service Addresses",
      "description": "Where our mobile grooming van should come. Used to calculate travel fees.",
      "fields": [
        {
          "id": "label",
          "label": "Address Label",
          "type": "text",
          "required": false,
          "placeholder": "Home, Office, Parent's house"
        },
        {
          "id": "street",
          "label": "Street Address",
          "type": "text",
          "required": true,
          "placeholder": "123 Palm Avenue"
        },
        {
          "id": "unit",
          "label": "Apt / Unit (optional)",
          "type": "text",
          "required": false,
          "placeholder": "Unit 4B"
        },
        {
          "id": "city",
          "label": "City",
          "type": "text",
          "required": true,
          "placeholder": "Orlando"
        },
        {
          "id": "state",
          "label": "State",
          "type": "text",
          "required": true,
          "placeholder": "FL"
        },
        {
          "id": "zip",
          "label": "ZIP Code",
          "type": "text",
          "required": true,
          "placeholder": "32801"
        },
        {
          "id": "parkingNotes",
          "label": "Parking / Access Notes",
          "type": "textarea",
          "required": false,
          "placeholder": "Driveway on left, gate code 1234"
        },
        {
          "id": "isDefault",
          "label": "Default service address",
          "type": "checkbox",
          "required": false
        }
      ]
    },
    {
      "id": "pets",
      "path": "/account/pets",
      "title": "My Pets",
      "allowMultiple": true,
      "description": "Save a profile for each pet. When booking, you will add or select a card after choosing your date and time — you are not charged when you book.",
      "fields": [
        {
          "id": "name",
          "label": "Pet Name",
          "type": "text",
          "required": true,
          "placeholder": "Bella"
        },
        {
          "id": "breed",
          "label": "Breed",
          "type": "text",
          "required": true,
          "placeholder": "Shih Tzu"
        },
        {
          "id": "weightLbs",
          "label": "Weight (lbs)",
          "type": "number",
          "required": true,
          "placeholder": "12"
        },
        {
          "id": "sex",
          "label": "Sex",
          "type": "select",
          "required": false,
          "options": [
            "Male",
            "Female",
            "Male, Neutered",
            "Female, Spayed"
          ]
        },
        {
          "id": "temperament",
          "label": "Temperament & Handling Notes",
          "type": "textarea",
          "required": false,
          "placeholder": "Nervous with dryers; prefers gentle handling"
        },
        {
          "id": "medicalNotes",
          "label": "Health & Comfort Notes",
          "type": "textarea",
          "required": false,
          "placeholder": "Senior dog, arthritis; no hot dryer on legs"
        },
        {
          "id": "groomingPreferences",
          "label": "Grooming Preferences",
          "type": "textarea",
          "required": false,
          "placeholder": "Keep eyelashes, clean around eyes etc."
        },
        {
          "id": "adminServiceNotes",
          "label": "Service & Product Notes (Admin Only)",
          "type": "textarea",
          "required": false,
          "adminOnly": true,
          "placeholder": "2026-07-15: Signature Bath, oatmeal shampoo, nail grind…"
        },
        {
          "id": "vaccineHeading",
          "label": "Rabies Vaccination",
          "type": "section-heading",
          "required": false
        },
        {
          "id": "rabiesStatus",
          "label": "Rabies Status",
          "type": "radio",
          "required": true
        },
        {
          "id": "vaccineRecord",
          "label": "Rabies Record",
          "type": "file",
          "required": false,
          "accept": ".pdf,.jpg,.jpeg,.png,.webp,.heic"
        },
        {
          "id": "vaccineExpiration",
          "label": "Record Expiration Date",
          "type": "date",
          "required": false
        }
      ]
    },
    {
      "id": "payment",
      "path": "/account/payment",
      "title": "Payment Methods",
      "description": "Save a card to use when you reserve an appointment. You choose which card to use for each visit and are not charged when you book.",
      "fields": [
        {
          "id": "savedCards",
          "label": "Saved Cards",
          "type": "payment-list",
          "required": true
        }
      ]
    },
    {
      "id": "referrals",
      "path": "/account/referrals",
      "title": "Referral Rewards",
      "description": "Your pet referral codes, share links, and available Referral Credit.",
      "fields": []
    },
    {
      "id": "bookings",
      "path": "/account/bookings",
      "title": "Booking History",
      "description": "Upcoming and past appointments. You can reschedule, cancel, or change the dogs on an upcoming visit.",
      "fields": [
        {
          "id": "upcoming",
          "label": "Upcoming Appointments",
          "type": "booking-list",
          "required": false
        },
        {
          "id": "past",
          "label": "Past Appointments",
          "type": "booking-list",
          "required": false
        }
      ]
    },
    {
      "id": "password",
      "path": "/account/password",
      "title": "Password",
      "description": "Set or change the password you use to sign in, so you do not need a new email code each visit.",
      "fields": []
    }
  ]
}
