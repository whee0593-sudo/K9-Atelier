# Team password for privacy / preview mode (required on Vercel when site.privacyMode is true)
SITE_ACCESS_PASSWORD=change-me-to-a-strong-password

# Support form email (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Optional: verified sender on your domain, e.g. "K9 Atelier <penny@k9atelier.com>"
# SUPPORT_FROM_EMAIL=K9 Atelier <penny@k9atelier.com>

# Add these in Vercel: open the K9 Atelier PROJECT (not team "All Projects"),
# Settings → Environment Variables → Add New → Production + Preview → Redeploy.
