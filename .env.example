# Team password for privacy / preview mode (required on Vercel when site.privacyMode is true)
SITE_ACCESS_PASSWORD=change-me-to-a-strong-password

# Password-free preview share link token (used in /preview/your-token-here)
SITE_PREVIEW_SHARE_TOKEN=k9atelier-preview-8f2a1c

# Supabase (Phase 1+ customer auth)
# Dashboard setup (redirect URLs, email templates): supabase/AUTH_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred for new Supabase projects:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback (still supported by app code):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phase 5 vaccination uploads only — NEVER use NEXT_PUBLIC_ prefix
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY

# Support form email (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Optional: verified sender on your domain, e.g. "K9 Atelier <penny@k9atelier.com>"
# SUPPORT_FROM_EMAIL=K9 Atelier <penny@k9atelier.com>

# Add these in Vercel: open the K9 Atelier PROJECT (not team "All Projects"),
# Settings → Environment Variables → Add New → Production + Preview → Redeploy.
